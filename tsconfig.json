{
  "compileOnSave": true,
  "compilerOptions": {
    "target": "es2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "commonjs",
    "resolveJsonModule": true,
    "types": ["node", "jest"],
    "strict": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,
    "noImplicitOverride": true,
    "declaration": true,
    "inlineSources": true,
    "preserveConstEnums": true,
    "removeComments": false,
    "sourceMap": true
  },
  "include": [
    "engines",
    "packages",
    "performance"
  ],
  "exclude": [
    "**/node_modules"
  ]
}
